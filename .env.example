# Julep Configuration
JULEP_API_KEY=your_julep_api_key_here

# Google Sheets Configuration
GOOGLE_SHEET_ID=your_google_sheet_id_here
SHEET_RANGE=Sheet1!A:F

# APIFY Configuration
APIFY_TOKEN=your_apify_token_here
APIFY_ACTOR_ID=pintostudio~youtube-transcript-scraper

# Email Configuration (Gmail SMTP) - Optional for future use
EMAIL_ADDRESS=your_email@example.com
GMAIL_APP_PASSWORD=your_app_password_here

# YouTube API (Optional - only if not using APIFY for everything)
YOUTUBE_API_KEY=

# Agent Configuration (will be populated after creation)
AGENT_ID=your_agent_id_here
TASK_ID=will_be_created_automatically

# Execution Settings
CHECK_INTERVAL=300  # seconds between checks (5 minutes)
MAX_RETRIES=3
DRY_RUN=false  # Set to true to test without sending emails

# Google Service Account (base64 encoded) - Optional
SERVICE_ACCOUNT_BASE64=